{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fingerwho",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // The Next.js static export (`npm run build:cf`); only `/ws` reaches the Worker code.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ws"]
  },
  // One Durable Object per room code. SQLite-backed classes are the kind the free plan allows.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }]
}
